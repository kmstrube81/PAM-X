#include "ui_mp/menudef.h"

// ==========================================================================
// PAM-X shoutcaster overlay (game["menu_caster"])
// Non-interactive overlay: cl_bypassMouseInput keeps mouse look with the game.
//
// Cvars (as set by PAM_CasterHUD / PAM_CasterUpdateScoreboard):
//   ui_scoreboard_team1_name / _team2_name / _score / _round / _gamestring
//   ui_scoreboard<N>_name  player name ("" = empty slot)     N 0-4 left = team1
//   ui_scoreboard<N>_a     kills/deaths string                 N 5-9 right = team2
//   ui_scoreboard<N>_b     health 1-100 alive | 0 dead | -1 empty slot (hides row)
//   ui_scoreboard<N>_c     "" | american | british | russian | german (has frag)
//   ui_scoreboard<N>_d     "" | "1" (has smoke)
// HUD elements drawn by GSC: round clock and one weapon icon per slot (see
// WEAPON notes). Responses: "0"-"9" (keys 1-0, follow slot), "closeCaster"
// ==========================================================================

{
	menuDef
	{
		name			"menu_caster"
		fullscreen		0
		rect			0 0 640 480
		focuscolor		1 1 1 1
		disablecolor	0 0 0 0
		style			WINDOW_STYLE_EMPTY
		onOpen
		{
			setCvar cl_bypassMouseInput "1";
			scriptMenuResponse "openCaster";
		}
		onClose
		{
			setCvar cl_bypassMouseInput "0"
		}
		onEsc
		{
			scriptMenuResponse "closeCaster";
			close menu_caster;
		}

// ---------------- MATCH BAR ----------------
		itemDef
		{
			name			"mb_bg"
			visible			1
			rect			192 0 326 58
			style			WINDOW_STYLE_FILLED
			backcolor		0 0 0 0.45
			decoration
		}
		itemDef
		{
			name			"mb_name1"
			visible			1
			rect			200 2 88 16
			cvar			"ui_scoreboard_team1_name"
			textfont		UI_FONT_NORMAL
			textscale		.3
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textalign		ITEM_ALIGN_RIGHT
			textalignx		88
			textaligny		13
			forecolor		1 1 1 1
			decoration
		}
		itemDef
		{
			name			"mb_score"
			visible			1
			rect			292 2 56 16
			cvar			"ui_scoreboard_score"
			textfont		UI_FONT_NORMAL
			textscale		.3
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textalign		ITEM_ALIGN_CENTER
			textalignx		28
			textaligny		13
			forecolor		1 1 1 1
			decoration
		}
		itemDef
		{
			name			"mb_name2"
			visible			1
			rect			348 2 100 16
			cvar			"ui_scoreboard_team2_name"
			textfont		UI_FONT_NORMAL
			textscale		.3
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textalign		ITEM_ALIGN_LEFT
			textalignx		0
			textaligny		13
			forecolor		1 1 1 1
			decoration
		}
