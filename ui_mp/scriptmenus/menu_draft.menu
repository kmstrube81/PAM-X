			textscale		.24
			textalignx		10
			textaligny		20
			cvartest		"ui_draftphase"
			showCvar		{ "0" ; "4" }
			action
			{
				play "mouse_click";
				scriptMenuResponse "option2";
			}
			onFocus
			{
				play "mouse_over";
			}
		}

		itemDef
		{
