#include "ui_mp/menudef.h"

#define ORIGIN_MENUTABS				96 64
#define ORIGIN_MENUWINDOW			96 96

// PAM-X captain draft menu (game["menu_draft"])
// ui_draftphase (set per captain by PAM_DraftUpdateUI):
//   0 : choose side or pick first        3 : team confirmed, waiting
//   1 : your pick                        4 : choose side (other captain picks first)
//   2 : other captain picking            5 : waiting on the other captain (sides/weapons)
// ui_scoreboard<0-9>_name : "N. name" shown as the slot button text
// ui_scoreboard<0-9>_c    : team shader path (selects which static icon is shown)
// ui_scoreboard<0-9>_d    : weapon shader path (selects which static icon is shown)
// ui_scoreboard<0-9>_b    : "1" shows the Cut button

{
	menuDef
	{
		name			"menu_draft"
		fullscreen		0
		rect			0 0 640 480
		focuscolor		1 1 1 1
		disablecolor	0 0 0 0
		style			WINDOW_STYLE_EMPTY
		onEsc
		{
			scriptMenuResponse "close";
			close menu_draft;
		}
		onOpen
		{
			scriptMenuResponse "open";
		}
		onClose
		{
			scriptMenuResponse "close";
		}

// WINDOW BACKGROUND
		itemDef
		{
			name			"window_background"
			visible			1
			rect			0 0 448 288
			origin			ORIGIN_MENUWINDOW
			style			WINDOW_STYLE_SHADER
			background		"ui_mp/assets/hud@window_background.tga"
			decoration
		}

// MENU TABS
		itemDef
		{
			name			"button_mainmenu"
			visible			1
			rect			0 0 89 32
			origin			ORIGIN_MENUTABS
			style			WINDOW_STYLE_SHADER
			background		"ui_mp/assets/hud@tab_left_unselected.tga"
			type			ITEM_TYPE_BUTTON
			text			"@MPMENU_MAIN_MENU"
			textfont		UI_FONT_NORMAL
			textscale		.24
			textalignx		45
			textaligny		24
			textalign		ITEM_ALIGN_CENTER
			action
			{
				play "mouse_click";
				close menu_draft;
				open main;
			}
			onFocus
			{
				play "mouse_over";
			}
		}

// DRAFT BANNER (fills the space of the removed Team/Weapon/View Map/Call Vote tabs)
		itemDef
		{
			name			"text_draftbanner"
			visible			1
			rect			89 0 358 32
			origin			ORIGIN_MENUTABS
			style			WINDOW_STYLE_SHADER
			background		"ui_mp/assets/hud@tab_center_selected.tga"
			forecolor		1 1 1 1
			cvar			"ui_draftbanner"
			textfont		UI_FONT_NORMAL
			textscale		.24
			textalignx		179
			textaligny		24
			textalign		ITEM_ALIGN_CENTER
			decoration
		}

// ==========================================================================
// PHASE 0 - SIDE / PICK FIRST  (hidden once ui_draftphase is 1)
// ==========================================================================
		itemDef
		{
			name			"button_allies"
			visible			1
			rect			16 24 160 23
			origin			ORIGIN_MENUWINDOW
			forecolor		1 1 1 1
			type			ITEM_TYPE_BUTTON
			text			"1. Allies"
			textfont		UI_FONT_NORMAL
			textscale		.24
			textalignx		10
			textaligny		20
			cvartest		"ui_draftphase"
			showCvar		{ "0" ; "4" }
			action
			{
				play "mouse_click";
				scriptMenuResponse "option1";
			}
			onFocus
			{
				play "mouse_over";
			}
		}

		itemDef
		{
			name			"button_axis"
			visible			1
			rect			16 48 160 23
			origin			ORIGIN_MENUWINDOW
