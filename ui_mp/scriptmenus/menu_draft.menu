// HOTKEYS
// 1-3 double as phase 0 keys: GSC treats option1/2/3 as Allies/Axis/Pick First while
// level.pam_draft is 0 or 1, and as player slots once level.pam_draft is 2.
		execKey "1" { play "mouse_click"; scriptMenuResponse "option1" }
		execKey "2" { play "mouse_click"; scriptMenuResponse "option2" }
		execKey "3" { play "mouse_click"; scriptMenuResponse "option3" }
		execKey "4" { play "mouse_click"; scriptMenuResponse "option4" }
		execKey "5" { play "mouse_click"; scriptMenuResponse "option5" }
		execKey "6" { play "mouse_click"; scriptMenuResponse "option6" }
		execKey "7" { play "mouse_click"; scriptMenuResponse "option7" }
		execKey "8" { play "mouse_click"; scriptMenuResponse "option8" }
		execKey "9" { play "mouse_click"; scriptMenuResponse "option9" }
		execKey "0" { play "mouse_click"; scriptMenuResponse "option10" }
		execKey "a" { play "mouse_click"; scriptMenuResponse "previous" }
		execKey "b" { play "mouse_click"; scriptMenuResponse "next" }
		execKey "y" { play "mouse_click"; scriptMenuResponse "skip" }
		execKey "z" { play "mouse_click"; scriptMenuResponse "readyup"; close menu_draft }
	}
}
